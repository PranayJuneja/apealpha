# Every credential below is optional. A missing key disables exactly one source
# and is reported on /sources rather than silently scoring zero.

# WebCMD is the primary live acquisition path. Every research run searches the
# connected X and Reddit sessions plus Google News and Yahoo News at query time.
APE_SOCIAL_MODE=auto
APE_WEBCMD_TIMEOUT=22
# Optional overrides for hosted installs or a custom Windows runtime:
WEBCMD_NODE_PATH=
WEBCMD_MAIN_PATH=

# Reddit Data API credentials are optional fallback only. In `auto` mode they
# are used if the authorized WebCMD Reddit session is unavailable. Keep them
# server-side; the normal local path needs only `webcmd reddit login`.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT="python:ape-alpha:v0.2.0 (by /u/YOUR_REDDIT_USERNAME)"

# Alpaca — intraday and as-of market bars. Without it, price falls back to
# Yahoo chart bars, which are keyless but end-of-day only.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# OpenAI — one structured narrative and interpretation call after deterministic
# scoring. Keep this server-side; GPT-5.6 Luna never chooses the stance.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT=45

# SEC requires a descriptive User-Agent. No key needed.
SEC_USER_AGENT=APE Alpha research contact@example.com

# WebCMD Google/Yahoo News and GDELT need no credentials.

APE_DATA_DIR=./data
APE_API_URL=http://127.0.0.1:8000
APE_CACHE_TTL=300
APE_HTTP_TIMEOUT=12
