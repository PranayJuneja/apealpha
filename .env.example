# Every credential below is optional. A missing key disables exactly one source
# and is reported on /sources rather than silently scoring zero.

# Reddit — the social leg. Request approved Data API access at:
# https://support.reddithelp.com/hc/en-us/articles/14945211791892
# The backend uses app-only OAuth; keep both credentials server-side.
# Without this the social leg is dark and no paper position can be sized.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT="python:ape-alpha:v0.2.0 (by /u/YOUR_REDDIT_USERNAME)"

# Alpaca — intraday and as-of market bars. Without it, price falls back to
# Yahoo chart bars, which are keyless but end-of-day only.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Groq — optional narrative layer. It writes prose about the computed metrics
# and never chooses the trading stance.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# SEC requires a descriptive User-Agent. No key needed.
SEC_USER_AGENT=APE Alpha research contact@example.com

# GDELT needs nothing at all.

APE_DATA_DIR=./data
APE_API_URL=http://127.0.0.1:8000
APE_CACHE_TTL=300
APE_HTTP_TIMEOUT=12
